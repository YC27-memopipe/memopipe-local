SCREENPIPE_LOCAL_API_URL=http://localhost:3030
SCREENPIPE_LOCAL_API_KEY=
CANARY_HUB_URL=http://localhost:3000
CANARY_TEAM_TOKEN=
# Identité du PC pour les analyses demandées depuis le hub : Alice, Bob ou Chloé.
CANARY_AUTHOR=Bob
# Agent (bun run canary:agent) : si défini, tous les emails envoyés par gmail.send arrivent dans cette boîte.
CANARY_TEST_INBOX=
# Navigateur piloté par Screenpipe pour gmail.send : owned-default (intégré) ou user-browser (extension).
CANARY_BROWSER=owned-default
