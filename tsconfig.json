{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "noEmit": true, "skipLibCheck": true,
    "types": ["bun"], "lib": ["ES2022", "DOM"], "allowImportingTsExtensions": true
  },
  "include": ["src/**/*.ts", "analyze/**/*.ts", "agent/**/*.ts", "tests/**/*.ts", "scripts/**/*.ts"]
}
